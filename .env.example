# Instantly API v2 key (Settings > Integrations > API Keys, scopes: leads, campaigns, block list)
INSTANTLY_API_KEY=
# Default Instantly campaign that new prospects are added to
INSTANTLY_CAMPAIGN_ID=

# HubSpot private app token (Settings > Integrations > Private Apps)
# Scopes: crm.objects.contacts.read/write, crm.objects.companies.read/write,
#         crm.objects.deals.read/write, crm.objects.owners.read
HUBSPOT_TOKEN=
# Owner who gets the follow-up task when a lead replies interested (optional)
HUBSPOT_OWNER_ID=
# Pipeline and stage for deals created from interested replies
HUBSPOT_PIPELINE=default
HUBSPOT_DEAL_STAGE=appointmentscheduled

# Shared secret appended to the Instantly webhook URL: https://your-host/webhooks/instantly?token=...
WEBHOOK_SECRET=

# Optional: SerpAPI key to pull live job postings from Google Jobs
SERPAPI_KEY=
